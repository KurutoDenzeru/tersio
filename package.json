{
  "name": "@krtclcdy/tersio",
  "version": "2.25.14",
  "description": "\u2702\ufe0f Token saver and usage tracker for coding agents: terse Caveman replies, compact RTK shell output, lean Ponytail code, pstack rigor, and a gain dashboard \u2014 one-command combos over one shared extension tree.",
  "keywords": [
    "token-saving",
    "ai-tools",
    "developer-tools",
    "caveman-mode",
    "rtk-rust-token-killer",
    "ponytail",
    "extensions",
    "pi",
    "pi-package"
  ],
  "license": "MIT",
  "author": "KurutoDenzeru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurutoDenzeru/tersio.git"
  },
  "type": "module",
  "bin": {
    "tersio": "dist/tersio.js"
  },
  "exports": {
    "./server": "./dist/extensions/server.js"
  },
  "pi": {
    "extensions": [
      "./extensions/caveman/index.ts",
      "./extensions/pstack/index.ts",
      "./extensions/rtk/session.ts",
      "./extensions/rtk/filter.ts",
      "./extensions/timing/index.ts",
      "./extensions/combo/index.ts",
      "./extensions/commands/index.ts",
      "./extensions/updater/index.ts"
    ],
    "skills": [
      "./extensions/ponytail/skills"
    ]
  },
  "omp": {
    "name": "Tersio",
    "description": "Toggleable Caveman/RTK/Ponytail session modes with Combo presets, plus the opt-in pstack rigor mode",
    "extensions": [
      "./extensions/caveman/index.ts",
      "./extensions/pstack/index.ts",
      "./extensions/rtk/session.ts",
      "./extensions/rtk/filter.ts",
      "./extensions/combo/index.ts",
      "./extensions/commands/index.ts"
    ],
    "skills": [
      "./extensions/ponytail/skills"
    ],
    "features": {
      "updater": {
        "description": "In-session updater for Ponytail, RTK, and Caveman (/tersio update)",
        "default": true,
        "extensions": [
          "./extensions/updater/index.ts"
        ]
      }
    },
    "settings": {
      "comboDefault": {
        "type": "enum",
        "description": "Session-start default (no saved state)",
        "values": [
          "off",
          "lite",
          "balanced",
          "max"
        ],
        "default": "off"
      },
      "comboSetupComplete": {
        "type": "boolean",
        "description": "Whether the first interactive OMP launch has completed the Combo preset prompt",
        "default": false
      },
      "cavemanDefault": {
        "type": "enum",
        "description": "Session-start default (no saved state)",
        "values": [
          "off",
          "lite",
          "full",
          "ultra",
          "megacave-lite",
          "megacave-full",
          "megacave-ultra"
        ],
        "default": "off"
      },
      "rtkDefault": {
        "type": "boolean",
        "description": "Session-start default (no saved state)",
        "default": false
      },
      "ponytailDefault": {
        "type": "enum",
        "description": "Session-start default; follows the combo preset unless overridden",
        "values": [
          "off",
          "lite",
          "full",
          "ultra"
        ],
        "default": "off"
      },
      "pstackDefault": {
        "type": "enum",
        "description": "Session-start default; every combo preset above off turns it on",
        "values": [
          "off",
          "on"
        ],
        "default": "off"
      },
      "currency": {
        "type": "enum",
        "description": "Display currency for usage/dashboard reports (--currency overrides per run)",
        "values": [
          "USD",
          "PHP",
          "EUR",
          "GBP",
          "JPY",
          "KRW",
          "SGD",
          "AUD",
          "CAD",
          "INR"
        ],
        "default": "USD"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dashboard/dist/**/*",
    "extensions/**/*.ts",
    "extensions/caveman/rule.md",
    "extensions/caveman/rule-lite.md",
    "extensions/caveman/rule-megacave-lite.md",
    "extensions/caveman/rule-megacave-ultra.md",
    "extensions/caveman/rule-ultra.md",
    "extensions/caveman/rule-megacave.md",
    "extensions/pstack/**/*.md",
    "extensions/ponytail/**/*",
    "plugins/tersio/assets/*"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && bun run build:dashboard",
    "build:dashboard": "bun install --cwd dashboard/app --frozen-lockfile && bun run --cwd dashboard/app build",
    "prepublishOnly": "bun run build",
    "check": "tsc --noEmit",
    "verify": "bun install --frozen-lockfile && bun run build && bun run test",
    "doctor": "node dist/tersio.js --doctor",
    "upstream": "node dist/tersio.js upstream",
    "dry-run": "node dist/tersio.js --dry-run --scope user --yes",
    "lint": "oxlint cli extensions test tersio.ts",
    "lint:dashboard": "bun run --cwd dashboard/app lint",
    "lint:fix": "oxlint cli extensions test tersio.ts --fix",
    "test": "vitest run",
    "bench": "vitest bench"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.22",
    "@types/node": "^26.4.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.0"
  }
}
