{
  "name": "@krtclcdy/tersio",
  "version": "2.25.19",
  "description": "✂️ Token saver and usage tracker for coding agents: terse Caveman replies, compact RTK shell output, lean Ponytail code, pstack rigor, Headroom compression, and a gain dashboard — one-command combos over one shared extension tree.",
  "keywords": [
    "ai-tools",
    "caveman-mode",
    "codex",
    "developer-tools",
    "extensions",
    "pi",
    "pi-package",
    "ponytail",
    "rtk-rust-token-killer",
    "token-saving"
  ],
  "license": "MIT",
  "author": "KurutoDenzeru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurutoDenzeru/tersio.git"
  },
  "bin": {
    "tersio": "dist/tersio.js"
  },
  "files": [
    "dist/**/*.js",
    "dashboard/dist/**/*",
    "skills/**/*",
    "extensions/**/*.ts",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/**/*",
    "plugins/**/*",
    "extensions/caveman/rule.md",
    "extensions/caveman/rule-lite.md",
    "extensions/caveman/rule-megacave-lite.md",
    "extensions/caveman/rule-megacave-ultra.md",
    "extensions/caveman/rule-ultra.md",
    "extensions/caveman/rule-megacave.md",
    "extensions/pstack/**/*.md",
    "extensions/dsh/**/*",
    "extensions/ponytail/**/*"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/extensions/dsh/index.js",
    "./package.json": "./package.json",
    "./server": "./dist/extensions/server.js",
    "./dsh-plugin": "./dist/extensions/dsh/index.js",
    "./client": "./dist/extensions/dsh/client.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && bun run build:dashboard && node -e \"require('node:fs').cpSync('extensions/ponytail/skills','skills',{recursive:true})\" && node -e \"require('node:fs').chmodSync('dist/tersio.js',0o755)\"",
    "build:dashboard": "bun install --cwd dashboard/app --frozen-lockfile && bun run --cwd dashboard/app build",
    "prepublishOnly": "bun run build",
    "check": "tsc --noEmit",
    "verify": "bun install --frozen-lockfile && bun run build && bun run test",
    "doctor": "node dist/tersio.js --doctor",
    "upstream": "node dist/tersio.js upstream",
    "dry-run": "node dist/tersio.js --dry-run --scope user --yes",
    "lint": "oxlint cli extensions test tersio.ts",
    "lint:dashboard": "bun run --cwd dashboard/app lint",
    "lint:fix": "oxlint cli extensions test tersio.ts --fix",
    "format": "oxfmt cli extensions test bench tersio.ts",
    "format:check": "oxfmt --check cli extensions test bench tersio.ts",
    "test": "vitest run",
    "bench": "vitest bench",
    "dev": "bun tersio.ts dashboard --watch"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.6",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./extensions/dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "omp": {
    "name": "Tersio",
    "description": "Toggleable Caveman/RTK/Ponytail session modes with Combo presets, plus the opt-in pstack rigor mode",
    "extensions": [
      "./extensions/caveman/index.ts",
      "./extensions/pstack/index.ts",
      "./extensions/headroom/index.ts",
      "./extensions/rtk/session.ts",
      "./extensions/rtk/filter.ts",
      "./extensions/combo/index.ts",
      "./extensions/commands/index.ts"
    ],
    "skills": [
      "./extensions/ponytail/skills"
    ],
    "features": {
      "updater": {
        "description": "In-session updater for Ponytail, RTK, and Caveman (/tersio update)",
        "default": true,
        "extensions": [
          "./extensions/commands/index.ts"
        ]
      }
    },
    "settings": {
      "comboDefault": {
        "type": "enum",
        "description": "Session-start default (no saved state)",
        "values": [
          "inherit",
          "off",
          "lite",
          "balanced",
          "max"
        ],
        "default": "inherit"
      },
      "comboSetupComplete": {
        "type": "boolean",
        "description": "Whether the first interactive OMP launch has completed the Combo preset prompt",
        "default": false
      },
      "cavemanDefault": {
        "type": "enum",
        "description": "Session-start default (no saved state)",
        "values": [
          "inherit",
          "off",
          "lite",
          "full",
          "ultra",
          "megacave-lite",
          "megacave-full",
          "megacave-ultra"
        ],
        "default": "inherit"
      },
      "rtkDefault": {
        "type": "enum",
        "description": "RTK on by default. inherit reads ~/.tersio/settings.json",
        "values": [
          "inherit",
          "on",
          "off"
        ],
        "default": "inherit"
      },
      "ponytailDefault": {
        "type": "enum",
        "description": "Session-start default; follows the combo preset unless overridden",
        "values": [
          "inherit",
          "off",
          "lite",
          "full",
          "ultra"
        ],
        "default": "inherit"
      },
      "pstackDefault": {
        "type": "enum",
        "description": "Session-start default; every combo preset above off turns it on",
        "values": [
          "inherit",
          "off",
          "on"
        ],
        "default": "inherit"
      },
      "headroomDefault": {
        "type": "enum",
        "description": "Session-start default for the opt-in Headroom token-saver; no combo preset turns it on",
        "values": [
          "inherit",
          "off",
          "on"
        ],
        "default": "inherit"
      },
      "currency": {
        "type": "enum",
        "description": "Display currency for usage/dashboard reports (--currency overrides per run)",
        "values": [
          "USD",
          "PHP",
          "EUR",
          "GBP",
          "JPY",
          "KRW",
          "SGD",
          "AUD",
          "CAD",
          "INR"
        ],
        "default": "USD"
      }
    }
  },
  "pi": {
    "extensions": [
      "./extensions/caveman/caveman.ts",
      "./extensions/pstack/pstack.ts",
      "./extensions/headroom/headroom.ts",
      "./extensions/rtk/session.ts",
      "./extensions/rtk/filter.ts",
      "./extensions/timing/timing.ts",
      "./extensions/combo/combo.ts",
      "./extensions/commands/commands.ts"
    ],
    "skills": [
      "./extensions/ponytail/skills"
    ]
  }
}
