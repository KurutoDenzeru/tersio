{
  "name": "@krtclcdy/tersio",
  "version": "2.23.0",
  "description": "\u2702\ufe0f Token-saving OMP add-ons: terse Caveman replies, compact RTK shell output, lean Ponytail code calls \u2014 one-command combo presets.",
  "keywords": [
    "omp",
    "token-saving",
    "ai-tools",
    "developer-tools",
    "caveman-mode",
    "rtk-rust-token-killer",
    "ponytail-omp",
    "extensions",
    "pi-package"
  ],
  "license": "MIT",
  "author": "KurutoDenzeru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurutoDenzeru/tersio.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "tersio": "tersio.js"
  },
  "files": [
    "tersio.js",
    "cli/**/*.js",
    "dashboard/dist/**/*",
    "extensions/**/*.js",
    "extensions/**/*.ts",
    "extensions/omp/caveman-session/rule.md"
  ],
  "scripts": {
    "clean": "rm -f tersio.js cli/*.js extensions/**/*.js && rm -rf dashboard/dist",
    "build": "tsc && bun run build:dashboard",
    "build:dashboard": "bun install --cwd dashboard/app --frozen-lockfile && bun run --cwd dashboard/app build",
    "prepublishOnly": "bun run build",
    "check": "tsc --noEmit",
    "doctor": "node tersio.js --doctor",
    "dry-run": "node tersio.js --dry-run --scope user --yes",
    "lint": "oxlint cli extensions test tersio.ts",
    "lint:dashboard": "bun run --cwd dashboard/app lint",
    "lint:fix": "oxlint cli extensions test tersio.ts --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@dietrichgebert/ponytail": "^4.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pi": {
    "extensions": [
      "./extensions/pi/ai-addons-updater/index.ts",
      "./extensions/pi/caveman-session/index.ts",
      "./extensions/pi/combo-toggle/index.ts",
      "./extensions/pi/rtk-session/index.ts",
      "./extensions/pi/tersio-commands/index.ts"
    ]
  },
  "omp": {
    "name": "Tersio",
    "description": "Toggleable Caveman/RTK/Ponytail session modes with Combo presets",
    "extensions": [
      "./extensions/omp/caveman-session/index.ts",
      "./extensions/omp/rtk-session/index.ts",
      "./extensions/omp/combo-toggle/index.ts",
      "./extensions/omp/tersio-commands/index.ts"
    ],
    "skills": [
      "./node_modules/@dietrichgebert/ponytail/skills"
    ],
    "features": {
      "updater": {
        "description": "In-session updater for Ponytail, RTK, and Caveman (/ai-addons)",
        "default": true,
        "extensions": [
          "./extensions/omp/ai-addons-updater/index.ts"
        ]
      }
    },
    "settings": {
      "comboDefault": {
        "type": "enum",
        "description": "Session-start default (no saved state)",
        "values": [
          "off",
          "medium",
          "balanced",
          "max"
        ],
        "default": "off"
      },
      "comboSetupComplete": {
        "type": "boolean",
        "description": "Whether the first interactive OMP launch has completed the Combo preset prompt",
        "default": false
      },
      "cavemanDefault": {
        "type": "enum",
        "description": "Session-start default (no saved state)",
        "values": [
          "off",
          "lite",
          "full",
          "ultra",
          "wenyan-lite",
          "wenyan-full",
          "wenyan-ultra"
        ],
        "default": "off"
      },
      "rtkDefault": {
        "type": "boolean",
        "description": "Session-start default (no saved state)",
        "default": false
      },
      "ponytailDefault": {
        "type": "enum",
        "description": "Session-start default; follows the combo preset unless overridden",
        "values": [
          "off",
          "lite",
          "full",
          "ultra"
        ],
        "default": "off"
      },
      "currency": {
        "type": "enum",
        "description": "Display currency for usage/dashboard reports (--currency overrides per run)",
        "values": [
          "USD",
          "PHP",
          "EUR",
          "GBP",
          "JPY",
          "KRW",
          "SGD",
          "AUD",
          "CAD",
          "INR"
        ],
        "default": "USD"
      }
    }
  }
}
